# Copy to .env and fill locally. Never commit .env.
# 复制为 .env 后在本地填写，禁止提交 .env。
PGDATABASE_URL=
# For the optional local PostgreSQL container / 可选的本地 PostgreSQL 容器
POSTGRES_PASSWORD=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=
SILICONFLOW_API_KEY=

# Optional public endpoint overrides; no production relay is included.
# 可选的公开服务端点覆盖；不包含生产中转服务。
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Required absolute local directory, e.g. an application-specific data directory.
# 必填绝对路径，指向应用专用的数据目录，不要放进 Git。
MEM0_OSS_DATA_DIR=
# Empty host uses local Qdrant; for a separate Qdrant server set your own host.
# 留空使用本地 Qdrant；独立部署时填写自己的服务器地址。
MEM0_OSS_QDRANT_HOST=
MEM0_OSS_QDRANT_PORT=6333
MEM0_TELEMETRY=false
